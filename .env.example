# ==============================================================================
# CodeItAnywhere Environment Configuration
# ==============================================================================

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=coding_platform
DB_PASSWORD=your_postgres_password_here
DB_PORT=5432

# Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key

# ==============================================================================
# AI Module Configuration (Choose Groq, Gemini, or OpenAI)
# ==============================================================================

# Option 1: Groq (Recommended: Ultra-fast <2s generation & 100% Free at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile

# Option 2: Google Gemini (Free Tier at aistudio.google.com)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash

# Option 3: OpenAI
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Demo & Investor Pitch Safe-Mode
# If set to true, or if no API key is provided, the platform uses an instant,
# zero-cost offline mock engine so demos never crash or lag during live pitches.
MOCK_AI=false
